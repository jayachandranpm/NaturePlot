{
  "name": "natureplot",
  "version": "0.7.0",
  "description": "A small, expressive, nature-inspired SVG chart library.",
  "type": "module",
  "main": "./dist/natureplot.js",
  "module": "./dist/natureplot.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/natureplot.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/natureplot.js",
      "default": "./dist/natureplot.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/API.md",
    "docs/CHART_CATALOG.md",
    "docs/FIFTY_CHARTS_PLAN.md",
    "docs/QUALITY_REVIEW.md",
    "docs/ART_DIRECTION.md",
    "docs/COMPLETE_ART_STUDIES.md",
    "docs/SCULPTURAL_CHARTS.md",
    "docs/NATIVE_SVG_REVIEW.md",
    "docs/PUBLISHING.md",
    "python/README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.demo.json",
    "test": "vitest run",
    "build:lib": "vite build --config vite.lib.config.ts && tsc --emitDeclarationOnly",
    "build:demo": "vite build && node scripts/copy-docs.mjs && node scripts/build-ai-docs.mjs",
    "build": "npm run typecheck && npm run build:lib && npm run build:demo",
    "preview": "vite preview --host 127.0.0.1",
    "prepublishOnly": "npm test && npm run build && npm run test:package",
    "test:package": "node tests/package-smoke.mjs && tsc --noEmit --module NodeNext --target ES2022 --lib ES2022,DOM --strict tests/package-types.mts",
    "review:charts": "node scripts/render-review.mjs",
    "prepare:python": "npm run build:lib && node scripts/prepare-python.mjs",
    "test:python": "python3 -m unittest discover -s python/tests",
    "test:python:package": "node tests/python-package-smoke.mjs"
  },
  "keywords": [
    "charts",
    "svg",
    "visualization",
    "nature",
    "calendar",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "jsdom": "^26.1.0",
    "minisearch": "^7.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://jayachandranpm.github.io/NaturePlot/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayachandranpm/NaturePlot.git"
  },
  "bugs": {
    "url": "https://github.com/jayachandranpm/NaturePlot/issues"
  }
}
